# Token público do Cesium ion. Restrinja por domínio no painel do ion.
# Sem token, o globo usa imagem simplificada (NaturalEarthII) e terreno plano.
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# Endereço da API do ortelius, lido só no servidor (nunca exposto ao navegador). Precisa existir também no
# build: as imagens (/midia/*) são repassadas à API por uma rewrite definida em next.config.ts.
ORTELIUS_API_URL=http://localhost:8000

# Endereço público do site, para a imagem de compartilhamento (og:image). Vazio: páginas sem og:image.
SITE_URL=
