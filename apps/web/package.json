{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "predev": "node scripts/copy-cesium-assets.mjs",
    "prebuild": "node scripts/copy-cesium-assets.mjs",
    "test": "vitest run",
    "api:sync": "node scripts/sync-openapi.mjs && npm run api:generate",
    "api:generate": "openapi-ts",
    "api:check": "openapi-ts && git diff --exit-code -- lib/api/generated"
  },
  "dependencies": {
    "cesium": "^1.147.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "5.1.0"
  }
}
